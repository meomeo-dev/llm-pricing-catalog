digraph catalog {
  graph [rankdir=TB, newrank=true, splines=spline, nodesep=0.5, ranksep=0.9, fontname="PingFang SC", label="llm-pricing-catalog ER 模型（由 schema/*.sql 生成）", labelloc=t, fontsize=20, pad=0.3];
